{
  "name": "chatnest",
  "version": "3.4.5",
  "description": "A lightweight, customizable, and responsive chat widget for modern web applications.",
  "keywords": [
    "chat",
    "widget",
    "chatbot",
    "ai",
    "assistant"
  ],
  "homepage": "https://github.com/Pro-Sifat-Hasan/chatnest#readme",
