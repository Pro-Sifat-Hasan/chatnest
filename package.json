    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "marked": "^9.1.6",
    "prettier": "^3.0.0",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "typescript": "^6.0.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
