  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pro-Sifat-Hasan/chatnest.git"
  },
  "license": "MIT",
  "author": "Sifat Hasan",
  "type": "commonjs",
  "main": "dist/chatnest.min.js",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
